---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE, person, t, type Lang } from '../data/profile';

interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean }
const { lang, noindex = false } = Astro.props;
const c = t[lang];
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;
const canonical = new URL(Astro.url.pathname, SITE).href;
const alt = { en: `${SITE}/`, es: `${SITE}/es/` };

const personId = `${SITE}/#person`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person', '@id': personId,
    name: person.name, alternateName: [person.handle, person.short],
    jobTitle: 'Software Engineer', description: c.meta.description, url: `${SITE}/`, email: `mailto:${person.email}`, image: `${SITE}/og.png`,
    address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: person.country },
    worksFor: { '@type': 'Organization', name: 'Upstart 13' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Escuela Politécnica Nacional', sameAs: 'https://www.epn.edu.ec' },
    hasCredential: [
      { '@type': 'EducationalOccupationalCredential', name: 'Microsoft Certified: Azure Administrator Associate (AZ-104)', credentialCategory: 'certification', recognizedBy: { '@type': 'Organization', name: 'Microsoft' } },
      { '@type': 'EducationalOccupationalCredential', name: 'Claude Certified Developer: Foundations', credentialCategory: 'certification', recognizedBy: { '@type': 'Organization', name: 'Anthropic' } },
    ],
    knowsAbout: ['Python', 'Django', 'TypeScript', 'React', 'Next.js', 'Prisma', 'PostgreSQL', 'Astro', 'Large Language Models', 'Claude Agent SDK','Retrieval-Augmented Generation', 'Microsoft Azure', 'Vercel', 'SEO', 'Generative Engine Optimization', 'Answer Engine Optimization'],
    knowsLanguage: ['es', 'en'],
    sameAs: [person.github, person.linkedin],
  },
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Alejololer', inLanguage: ['en', 'es'], publisher: { '@id': personId } },
  { '@type': 'ProfilePage', '@id': `${canonical}#page`, url: canonical, name: title, inLanguage: lang,
    dateModified: new Date().toISOString(),   // ponytail: build date = last deploy; switch to a hand-kept date if rebuilds without content changes become common
    isPartOf: { '@id': `${SITE}/#website` }, mainEntity: { '@id': personId } },
];
if (!noindex) graph.push({
  '@type': 'FAQPage', '@id': `${canonical}#faq`, inLanguage: lang,
  mainEntity: c.faq.items.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');   // copy can never close the script tag
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  {!noindex && <>
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="es" href={alt.es} />
    <link rel="alternate" hreflang="x-default" href={alt.en} />
  </>}
  <meta name="author" content={person.name} />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="profile" />
  <meta property="og:site_name" content="Alejololer" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE}/og.png?v=2026-11-16b`} />{/* bump ?v when og.png changes: social sites cache previews by URL */}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_EC' : 'en_US'} />
  <meta property="profile:first_name" content="Carlos Alejandro" />
  <meta property="profile:last_name" content="Alemán Osorio" />
  <meta property="profile:username" content={person.handle} />
  <meta name="twitter:card" content="summary_large_image" />

  {/* preload only what the first screen paints; latin-ext and the 500 weight load on demand */}
  <Font cssVariable="--font-sans" preload={[{ subset: 'latin', weight: 300 }, { subset: 'latin', weight: 700 }]} />
  <Font cssVariable="--font-mono" preload={[{ subset: 'latin' }]} />
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <canvas id="scene" aria-hidden="true"></canvas>
  <div class="crt" aria-hidden="true"></div>
  <div class="caret" aria-hidden="true"></div>
  <slot />
  <script>
    import '../scripts/eggs';
    const canvas = document.getElementById('scene') as HTMLCanvasElement;
    // the 3D scene is decoration: load it after the page is interactive so it never blocks the first paint.
    // ponytail: on phones, parsing three.js costs ~400ms of main thread, so wait for the first touch/scroll (8s fallback)
    let started = false;
    const go = (frozen = false) => {
      if (started) return;
      started = true;
      import('../scripts/scene').then(m => { m.start(canvas, frozen); canvas.classList.add('on'); });
    };
    // no GPU (software WebGL: virtual machines, blocked drivers, headless browsers): every frame would hold the main
    // thread for hundreds of ms. Those open on one frame of the scene as an image (global.css, #scene.still) and only load
    // three.js once someone moves, touches or types, frozen: it redraws only when the figure moves or is clicked.
    // The renderer's name is checked too: some software renderers pass failIfMajorPerformanceCaveat.
    const hasGpu = () => {
      const gl = document.createElement('canvas').getContext('webgl2', { failIfMajorPerformanceCaveat: true });
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const name = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return !/swiftshader|llvmpipe|softpipe|software|basic render/i.test(name);
    };
    const boot = () => {
      const gpu = hasGpu(), coarse = matchMedia('(pointer: coarse)').matches;
      if (!gpu) canvas.classList.add('still', 'on');
      else if (!coarse) return go();
      for (const ev of ['scroll', 'touchstart', 'pointerdown', 'pointermove', 'keydown']) addEventListener(ev, () => go(!gpu), { once: true, passive: true });
      if (gpu) setTimeout(go, 8000);
    };
    if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1500 });
    else setTimeout(boot, 300);
  </script>
</body>
</html>
